# Environment
NODE_ENV=development
WEBSITE_URL=http://localhost:3000
APPLICATION_ID=

# Better Auth - Configuration
BETTER_AUTH_SECRET=

# Database (Turso)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Gateway Configuration
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Payments and tracking
AUTUMN_SECRET_KEY=

# Email delivery (Resend) — powers contact/enquiry form notifications
# API key: https://resend.com/api-keys  (must start with "re_")
RESEND_API_KEY=
# Sender address; its domain must be verified at https://resend.com/domains
RESEND_FROM=
# Where enquiry notifications are delivered
LEADS_NOTIFY_EMAIL=
# Events desk (conferences & exhibitions enquiries)
RESEND_FROM_EVENTS=
EVENTS_NOTIFY_EMAIL=

# GA4 Measurement ID (format "G-XXXXXXXXXX") — optional. Set it to load gtag.js
# and start sending generate_lead / click_phone / click_whatsapp / click_email /
# file_download / service_cta_click / form_start / contact_page_view events to
# Google Analytics. Without it, the same events still fire into
# window.dataLayer (see src/web/lib/analytics.ts) but nothing is sent anywhere.
VITE_GA4_MEASUREMENT_ID=
